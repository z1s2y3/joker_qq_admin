[Unit]
Description=Joker QQ Official Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/joker_qq_admin/joker_qq_admin.env
ExecStart=__APP_DIR__/.venv/bin/python -m joker_qq_admin
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/joker_qq_admin

[Install]
WantedBy=multi-user.target

