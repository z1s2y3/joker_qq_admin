QQBOT_APP_ID=102604960
QQBOT_APP_SECRET=

# 官方生产 API。沙箱或代理环境请按控制台填写完整地址。
QQBOT_API_BASE=https://api.sgroup.qq.com
QQBOT_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
QQBOT_GATEWAY_URL=
QQBOT_TRANSPORT=webhook

# QQ 官方机器人群/C2C 事件意图，默认使用群与 C2C 消息意图。
QQBOT_INTENTS=33554432
QQBOT_REQUEST_TIMEOUT=20
QQBOT_RECONNECT_MIN=1
QQBOT_RECONNECT_MAX=30

# 本地 SQLite 数据目录。部署时建议使用绝对路径。
JOKER_QQ_DATA_DIR=data

# SCUM 查询中转。Key 只放在服务器环境文件，不提交到 Git。
SCUM_RELAY_URL=https://ba.yooyun.top
SCUM_RELAY_KEY=

# 可选：主人 openid 和已有游戏执行桥接地址。
QQBOT_OWNER_OPENID=
JOKER_GAME_BRIDGE_URL=
JOKER_GAME_BRIDGE_TOKEN=

# 网页控制台。默认只允许服务器本机访问；对外开放时必须设置访问令牌。
JOKER_DASHBOARD_BIND=127.0.0.1
JOKER_DASHBOARD_PORT=8080
JOKER_DASHBOARD_TOKEN=

