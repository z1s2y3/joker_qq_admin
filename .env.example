QQBOT_APP_ID=102604960
QQBOT_APP_SECRET=

# 官方生产 API。沙箱或代理环境请按控制台填写完整地址。
QQBOT_API_BASE=https://api.bot.qq.com
QQBOT_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
QQBOT_GATEWAY_URL=
QQBOT_TRANSPORT=webhook

# QQ 官方机器人群/C2C 事件意图。33554432 对应群与 C2C 消息事件；
# 非 @ 群消息仍需要在 QQ 开放平台和目标群开启全量消息权限。
QQBOT_INTENTS=33554432
QQBOT_REQUEST_TIMEOUT=20
QQBOT_RECONNECT_MIN=1
QQBOT_RECONNECT_MAX=30

# 本地 SQLite 数据目录。部署时建议使用绝对路径。
JOKER_QQ_DATA_DIR=data

# SCUM 查询中转。Key 只放在服务器环境文件，不提交到 Git。
SCUM_RELAY_URL=https://ba.yooyun.top
SCUM_RELAY_KEY=

# 可选：主人 openid 和已有游戏执行桥接地址。
QQBOT_OWNER_OPENID=
QQBOT_ADMIN_OPENIDS=
JOKER_GAME_BRIDGE_URL=
JOKER_GAME_BRIDGE_TOKEN=
JOKER_PORTAL_URL=https://web.yooyun.top

# 网页控制台。默认只允许服务器本机访问；对外开放时必须设置访问令牌。
JOKER_DASHBOARD_BIND=127.0.0.1
JOKER_DASHBOARD_PORT=8080
JOKER_DASHBOARD_TOKEN=
JOKER_DASHBOARD_PATH=/admin
JOKER_ADMIN_PATH=/admin
JOKER_USER_PATH=/user

# 控制台登录和 QQ 用户授权。
JOKER_ADMIN_USERNAME=admin
JOKER_ADMIN_PASSWORD=
JOKER_DASHBOARD_SESSION_MAX_AGE=604800
JOKER_BOT_AUTH_REQUIRED=1

# 用户注册和邮箱登录配置。SMTP 留空时仍可使用账号密码注册登录。
JOKER_SMTP_HOST=
JOKER_SMTP_PORT=587
JOKER_SMTP_USERNAME=
JOKER_SMTP_PASSWORD=
JOKER_SMTP_FROM=
JOKER_SMTP_USE_TLS=1
JOKER_REGISTRATION_REQUIRE_EMAIL=0

